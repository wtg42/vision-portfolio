---
const title = "Redirecting to Vision Portfolio";
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content="0;url=/#works" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const labels = {
          landscape: "Landscape",
          portraits: "Portraits",
          urban: "Urban",
        };
        const requested = new URLSearchParams(window.location.search)
          .get("category")
          ?.toLowerCase();
        const category = requested && labels[requested];
        const target = category
          ? `/?category=${encodeURIComponent(category)}#works`
          : "/#works";
        window.location.replace(target);
      })();
    </script>
  </head>
  <body>
    <p>正在前往 <a href="/#works">Vision Portfolio</a>…</p>
  </body>
</html>
