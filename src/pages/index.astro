---
import PortfolioTerminal from "../components/PortfolioTerminal";
import { photos, type PhotoViewModel } from "../data/photos";
import Layout from "../layouts/Layout.astro";

const photoViewModels: PhotoViewModel[] = photos.map(
  ({ thumbnail, full, ...metadata }) => {
    return {
      ...metadata,
      thumbnail: {
        src: thumbnail.src,
        width: thumbnail.width,
        height: thumbnail.height,
      },
      full: {
        src: full.src,
        width: full.width,
        height: full.height,
      },
    };
  },
);
---

<Layout>
  <PortfolioTerminal photos={photoViewModels} client:load />
</Layout>
